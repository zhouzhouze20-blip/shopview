# gwzxcj.cbxsj.com 的 HTTPS 反向代理示例。
# 启用此配置前，请将 .env 的 PUBLIC_BASE_URL 改为 https://gwzxcj.cbxsj.com，
# 并将 FIREWORKS_BIND_IP 改为 127.0.0.1。

server {
    listen 80;
    listen [::]:80;
    server_name gwzxcj.cbxsj.com;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name gwzxcj.cbxsj.com;

    ssl_certificate /etc/letsencrypt/live/gwzxcj.cbxsj.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gwzxcj.cbxsj.com/privkey.pem;

    client_max_body_size 32k;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
